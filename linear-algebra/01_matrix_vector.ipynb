   "source": [
    "def matvec(A,x):\n",
    "    result = [0] * len(A)\n",
    "    for i in range(len(A[0])):\n",
    "        for j in range (len(A)):\n",
    "            result [j] += A[j][i] * x[i]\n",
    "    return result\n",
    "            \n",
    "matvec([[1, 0, 0], [0, 1, 0], [0, 0, 1]], [4, 5, 6])\n",
    "    "
   ]
